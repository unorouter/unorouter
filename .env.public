NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/unorouter/
NEXT_PUBLIC_POSTHOG_DISABLED=false
NEXT_PUBLIC_POSTHOG_HOST=https://ph.unorouter.com
